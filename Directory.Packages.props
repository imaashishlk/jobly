<!--
  Central package management: the version of every NuGet package is set here, once.
  Project files list packages by name only (<PackageReference Include="..." />).
  Adding a package means adding a line here, which needs approval (see .claude/rules/code-style.md).
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below also override the version of a package that only arrives indirectly (see Security fixes). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Database">
    <!-- EF Core with the SQL Server provider: maps our entities to SQL Server tables. Same version as the dotnet-ef tool (10.0.13). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Needed by `dotnet ef migrations add` in the startup project. Used only at development time. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Security fixes">
    <!--
      Pulled in indirectly by EF Core's SQL Server provider (through Microsoft.Data.SqlClient) at 9.0.11,
      which has known security advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). We pin a patched
      version for the whole solution. Remove this when EF Core / SqlClient bring a patched one themselves.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- Runs the real API in memory for integration tests. Matches the installed ASP.NET Core runtime (10.0.12). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- The .NET test host that `dotnet test` needs. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- Lets `dotnet test` and VS Code discover and run xUnit tests. -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- The test framework. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
