<!--
  Central package management: the version of every NuGet package is set here, once.
  Project files list packages by name only (<PackageReference Include="..." />).
  Adding a package means adding a line here, which needs approval (see .claude/rules/code-style.md).
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Database">
    <!-- EF Core with the PostgreSQL provider (Npgsql): maps our entities to PostgreSQL tables. Works with EF Core 10. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Needed by `dotnet ef migrations add` in the startup project. Used only at development time. Same version as the dotnet-ef tool (10.0.13). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Documents">
    <!-- Reads the text out of an uploaded PDF CV. The official package id is PdfPig (the older UglyToad.PdfPig id is abandoned). -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <!-- Microsoft's Open XML SDK: reads the text out of an uploaded DOCX CV. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- Runs the real API in memory for integration tests. Matches the installed ASP.NET Core runtime (10.0.12). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- The .NET test host that `dotnet test` needs. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- Lets `dotnet test` and VS Code discover and run xUnit tests. -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- The test framework. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
