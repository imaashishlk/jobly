# Formatting and style rules. `dotnet format` applies them, and VS Code follows them while you type.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# One namespace line at the top of the file instead of wrapping the whole file in braces.
csharp_style_namespace_declarations = file_scoped:suggestion
# Usings go at the top of the file, System namespaces first.
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true
# Use `var` when the type is obvious from the right-hand side, the explicit type otherwise.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
# Braces on their own line (standard C# style).
csharp_new_line_before_open_brace = all
# Private fields are camelCase (no underscore), matching primary constructor parameters.
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case
dotnet_naming_rule.private_fields_camel_case.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case.capitalization = camel_case
