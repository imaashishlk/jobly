# Copy this file to docker/.env and fill in the values. docker/.env is gitignored and never committed.

# Ports on your machine. Unusual on purpose, because common ports are often taken. Change them here if they clash.
JOBLY_API_PORT=48217
JOBLY_CLIENT_PORT=48251
JOBLY_DB_PORT=48233

# Password for the PostgreSQL user "jobly" (local development only).
# It is set when the database volume is first created. Changing it here later does not change an existing database.
POSTGRES_PASSWORD=change-me

# The language model (Ollama). Ollama runs on your machine, outside Docker. Install it, keep it running, and download the models once:
#   ollama pull qwen2.5:7b     (answers questions, about 4.7 GB; a faster choice is gemma3:4b)
#   ollama pull bge-m3         (turns text into vectors for search, about 1.2 GB)
# These three lines are optional: without them the defaults shown here are used. Uncomment a line to change it.
# JOBLY_LLM_BASE_URL=http://host.docker.internal:11434
# JOBLY_LLM_CHAT_MODEL=qwen2.5:7b
# JOBLY_LLM_EMBEDDING_MODEL=bge-m3

# The connection string the API uses to reach PostgreSQL inside Docker. It becomes the setting ConnectionStrings:Jobly.
#   - "Host=postgres" is the name of the PostgreSQL service in docker-compose.yml, not a machine name.
#     Containers on the same compose network find each other by service name. Port 5432 is the port inside Docker.
#   - "Database=jobly" and "Username=jobly" match POSTGRES_DB and POSTGRES_USER in docker-compose.yml.
#   - Replace {same-as-POSTGRES_PASSWORD} with the exact value of POSTGRES_PASSWORD above (without the braces).
# In your own docker/.env this line holds the real password, so never put the real one in this example file.
JOBLY_CONNECTION_STRING=Host=postgres;Port=5432;Database=jobly;Username=jobly;Password={same-as-POSTGRES_PASSWORD}
