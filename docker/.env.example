# Copy this file to docker/.env and fill in the values. docker/.env is gitignored and never committed.

# Ports on your machine. Unusual on purpose, because common ports are often taken. Change them here if they clash.
JOBLY_API_PORT=48217
JOBLY_CLIENT_PORT=48251
JOBLY_SQL_PORT=48233

# Password for SQL Server's "sa" account (local development only).
# SQL Server requires at least 8 characters with upper case, lower case, a digit and a symbol, or the container won't start.
SQL_SA_PASSWORD=change-me

# The connection string the API uses to reach SQL Server inside Docker. It becomes the setting ConnectionStrings:Jobly.
#   - "Server=sqlserver" is the name of the SQL Server service in docker-compose.yml, not a machine name.
#     Containers on the same compose network find each other by service name.
#   - "Database=Jobly" is created when the migration runs. It does not exist yet in a fresh container.
#   - Replace {same-as-SQL_SA_PASSWORD} with the exact value of SQL_SA_PASSWORD above (without the braces).
#   - TrustServerCertificate=True is needed because the local SQL Server uses a self-signed certificate.
# In your own docker/.env this line holds the real password, so never put the real one in this example file.
JOBLY_CONNECTION_STRING=Server=sqlserver;Database=Jobly;User Id=sa;Password={same-as-SQL_SA_PASSWORD};TrustServerCertificate=True
